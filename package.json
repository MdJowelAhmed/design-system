    "build:tokens": "tsx src/tokens/sd.config.ts",
    "build:bundle": "node --max-old-space-size=8192 ./node_modules/tsup/dist/cli-default.js",
    "build": "pnpm run build:tokens && pnpm run build:bundle",
    "dev": "node --max-old-space-size=8192 ./node_modules/tsup/dist/cli-default.js --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
