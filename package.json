  "scripts": {
    "build:tokens": "tsx src/tokens/sd.config.ts",
    "build:bundle": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "build": "node scripts/clean.mjs dist && pnpm build:tokens && pnpm sync:exports && pnpm build:bundle",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup --watch",
    "sync:exports": "node scripts/sync-exports.mjs",
    "new:component": "node scripts/new-component.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "pnpm build:tokens && cross-env STORYBOOK_DISABLE_TELEMETRY=1 NODE_OPTIONS=--max-old-space-size=8192 storybook build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "check:generated": "node scripts/check-generated.mjs",
    "validate": "pnpm check:generated && pnpm type-check && pnpm lint && pnpm format:check && pnpm test",
    "chromatic": "chromatic",
    "clean": "node scripts/clean.mjs dist storybook-static node_modules/.cache",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
